<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lambamba Coin Rush</title>
<style>
body{margin:0;background:#0a5c26;color:#fff;font-family:sans-serif;text-align:center;padding:20px}
.box{background:#fff;color:#0a5c26;padding:20px;border-radius:20px;max-width:380px;margin:20px auto}
button{background:#ffcc00;border:0;padding:18px;border-radius:30px;width:100%;font-weight:900;font-size:20px;margin-top:12px}
#coin{font-size:110px}
</style>
</head>
<body>
<h1>🐑 LAMBAMBA<br>COIN RUSH</h1>
<p>Ghana's Fastest Cash Game</p>
<div class=box>
<h2>Balance: GHS <span id=bal>0</span></h2>
<div id=coin>🪙</div>
<p>Tap coin! Coins: <span id=c>0</span></p>
<button onclick="document.getElementById('c').innerText=++n;if(n>9){document.getElementById('bal').innerText=5;alert('YOU WON GHS 5!')}">START GAME</button>
<button style="background:#0a5c26;color:#fff">Deposit MoMo (Paystack Active)</button>
</div>
<script>let n=0</script>
</body>
</html>